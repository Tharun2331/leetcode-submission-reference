Brute Force: 
/**
 * @param {number} target
 * @param {number[]} nums
 * @return {number}
 */
var minSubArrayLen = function(target, nums) {
    let minn = Infinity
    const n = nums.length;
    for(let i=0; i<n; i++) {
        let sum = 0;
        for(let j=i; j<n;j++) {
            sum+=nums[j]
            if(sum >= target) {
                minn = Math.min(minn, j-i+1)
                break
            }
        }

    }
    return minn === Infinity? 0: minn
    
};


Optimal:
/**
 * @param {number} target
 * @param {number[]} nums
 * @return {number}
 */
var minSubArrayLen = function(target, nums) {
    let minn = Infinity
    const n = nums.length;
    let i=0, j=0;
    let sum = 0;
    while(j<n) {
        sum += nums[j];
        while(sum >= target) {
            minn = Math.min(minn,j-i+1)
            sum -= nums[i]
            i++
        }
        j++
    }
    return minn === Infinity? 0 : minn 
};
